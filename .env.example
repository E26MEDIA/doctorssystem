# PostgreSQL (required)
# Local: same value for both
# Neon/Vercel: DATABASE_URL = pooled, DIRECT_URL = direct (non-pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Required in production: random string, min 32 characters
ADMIN_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Required in production. Dev fallback is Demo@12345 only when unset.
ADMIN_PASSWORD="Demo@12345"

NEXT_PUBLIC_CLINIC_NAME="Honnani GI Surgery"
NEXT_PUBLIC_DOCTOR_NAME="Dr. Sharath S. Honnani"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Appointment {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  date           String
  time           String
  service        String
  visitType      String   @default("clinic-consultation")
  meetLink       String?
  paymentStatus  String   @default("not_required") // not_required | unpaid | paid
  paymentAmount  Int      @default(0)
  paymentRef     String?
  paymentMethod  String?
  payToken       String?  @unique
  notes          String?
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ClinicSettings {
  id                 String   @id @default("default")
  clinicName         String
  doctorName         String
  credentials        String
  tagline            String
  phone              String
  email              String
  addressLine1       String
  addressLine2       String
  instagram          String   @default("")
  linkedin           String   @default("")
  hoursJson          String
  timeSlotsJson      String
  weeklyScheduleJson String   @default("[]")
  dateScheduleJson   String   @default("[]")
  bookingEnabled     Boolean  @default(true)
  minLeadDays        Int      @default(1)
  maxAdvanceDays     Int      @default(60)
  autoConfirm        Boolean  @default(true)
  confirmationNote   String   @default("Your appointment is confirmed. You and the doctor will receive email details for this slot.")
  notifyEmail        String   @default("")
  notifyOnBooking    Boolean  @default(true)
  notifyOnContact    Boolean  @default(true)
  emergencyNote      String   @default("Not for emergencies — call local emergency services if needed.")
  updatedAt          DateTime @updatedAt
}

model ServiceOffering {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  details   String
  duration  String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model AdminAccount {
  id           String   @id @default("admin")
  passwordHash String?
  updatedAt    DateTime @updatedAt
}

model JournalArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  excerpt     String
  bodyJson    String
  imageUrl    String   @default("/images/gallery-1.jpg")
  publishedAt String
  readTime    String   @default("5 min")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
